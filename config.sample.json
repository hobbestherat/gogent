{
  "default_model": "local-lan",
  "connections": [
    {
      "name": "local-lan",
      "api_type": "openai",
      "endpoint": "http://192.168.1.88:8080/v1/chat/completions"
    },
    {
      "name": "localhost",
      "api_type": "openai",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions"
    },
    {
      "name": "groq",
      "api_type": "openai",
      "endpoint": "https://api.groq.com/openai/v1/chat/completions",
      "api_key": ""
    },
    {
      "name": "openrouter",
      "api_type": "openrouter",
      "api_key": ""
    },
    {
      "name": "zai",
      "api_type": "zai",
      "api_key": ""
    },
    {
      "name": "zai-coding",
      "api_type": "zai",
      "endpoint": "https://api.z.ai/api/coding/paas/v4",
      "api_key": ""
    },
    {
      "name": "vertex",
      "api_type": "vertex",
      "project": "your-gcp-project",
      "location": "us-central1"
    },
    {
      "name": "vertex-claude",
      "api_type": "vertex-anthropic",
      "project": "your-gcp-project",
      "location": "global"
    }
  ],
  "models": [
    {
      "name": "local-lan",
      "display_name": "Local LAN (env: GOGENT_MODEL_URL)",
      "connection": "local-lan",
      "model": "default",
      "temperature": 0.7,
      "max_tokens": 262144,
      "caps": { "context_window": 262144, "max_output": 262144, "source": "manual" }
    },
    {
      "name": "localhost",
      "display_name": "Localhost (127.0.0.1)",
      "connection": "localhost",
      "model": "default",
      "temperature": 0.7,
      "max_tokens": 262144,
      "caps": { "context_window": 262144, "max_output": 262144, "source": "manual" }
    },
    {
      "name": "groq-free",
      "display_name": "Groq (API Key Required)",
      "connection": "groq",
      "model": "llama-3.3-70b-versatile",
      "temperature": 0.7,
      "max_tokens": 32768,
      "caps": { "context_window": 131072, "max_output": 32768, "tool_call": true, "source": "manual" }
    },
    {
      "name": "openrouter-free",
      "display_name": "OpenRouter (gemma-3-27b-it)",
      "connection": "openrouter",
      "model": "google/gemma-3-27b-it:free",
      "temperature": 0.7,
      "max_tokens": 16384,
      "caps": { "context_window": 131072, "max_output": 16384, "source": "manual" }
    },
    {
      "name": "zai-glm",
      "display_name": "Z.AI (API Key Required)",
      "connection": "zai",
      "model": "glm-4.6",
      "temperature": 0.7,
      "max_tokens": 131072,
      "caps": { "context_window": 204800, "max_output": 131072, "reasoning": true, "tool_call": true, "source": "manual" }
    },
    {
      "name": "zai-glm-5.2",
      "display_name": "Z.AI GLM-5.2 (Coding Plan, API Key Required)",
      "connection": "zai-coding",
      "model": "glm-5.2",
      "temperature": 0.7,
      "max_tokens": 131072,
      "reasoning_effort": "high",
      "caps": {
        "context_window": 1000000,
        "max_output": 131072,
        "reasoning": true,
        "tool_call": true,
        "effort_options": ["high", "max"],
        "source": "manual"
      }
    },
    {
      "name": "gemini-vertex",
      "display_name": "Gemini on Vertex AI (GCP ADC; Discover models)",
      "connection": "vertex",
      "model": "google/gemini-2.5-flash",
      "max_tokens": 8192,
      "caps": { "context_window": 1000000, "max_output": 8192, "reasoning": true, "tool_call": true, "vision": true, "source": "manual" }
    },
    {
      "name": "claude-vertex",
      "display_name": "Claude on Vertex AI (GCP ADC; no API key)",
      "connection": "vertex-claude",
      "model": "claude-opus-4-8",
      "max_tokens": 8192,
      "thinking": true,
      "caps": { "context_window": 1000000, "max_output": 8192, "reasoning": true, "thinking_toggle": true, "tool_call": true, "vision": true, "source": "manual" }
    }
  ],
  "fast_model": "",
  "model_roles": {},
  "sub_agents": {
    "execution_model": "both",
    "allow_recursive": false,
    "max_subagents": 4,
    "max_depth": 3,
    "max_concurrent": 8,
    "token_budget": 0
  },
  "timeouts": {
    "model_seconds": 300,
    "tool_seconds": 300,
    "subagent_seconds": 300
  },
  "max_steps": 25,
  "window": {
    "resizable": true,
    "minimizable": true,
    "maximizable": true,
    "min_width": 50,
    "min_height": 12
  },
  "budget": {
    "token_budget": 0,
    "warn_fraction": 0.8
  },
  "rate_limit": {
    "requests_per_minute": 0,
    "burst": 0
  },
  "review_edits": false,
  "notify": {
    "enabled": true,
    "bell": true,
    "desktop": true,
    "native": false,
    "on_complete": true,
    "on_error": true,
    "on_approval": true,
    "on_clarify": true,
    "on_watcher": true,
    "suppress_when_focused": false
  },
  "mcp_servers": [],
  "lsp_servers": [
    {
      "name": "gopls",
      "language": "go",
      "extensions": [".go"],
      "command": "gopls",
      "args": ["serve"],
      "root_markers": ["go.work", "go.mod"]
    }
  ],
  "theme": {
    "name": "default",
    "no_color": false,
    "no_shadow": false,
    "overrides": {}
  },
  "keybindings": {
    "overrides": {
      "session.new": "Ctrl+T",
      "transcript.toggle.thinking": "i",
      "transcript.find": "none"
    }
  },
  "experimental": {
    "supervisor": false,
    "stream_thinking": false,
    "watchers": false
  },
  "supervisor": {
    "max_nudges": 3
  },
  "watchers": {
    "max_concurrent": 4,
    "default_skip_if_running": true
  }
}
