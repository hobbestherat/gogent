      "temperature": 0.7,
      "max_tokens": 32768,
      "context_window": 131072,
      "free": false
    },
    {
      "name": "openrouter",
      "display_name": "OpenRouter (gemma-3-27b-it)",
      "api_type": "openrouter",
      "endpoint": "",
      "model": "google/gemma-3-27b-it:free",
      "api_key": "",
      "temperature": 0.7,
      "max_tokens": 16384,
      "context_window": 131072,
      "free": false
    },
    {
      "name": "zai-glm",
      "display_name": "Z.AI (API Key Required)",
      "api_type": "zai",
      "endpoint": "",
      "model": "glm-4.6",
      "api_key": "",
      "temperature": 0.7,
      "max_tokens": 131072,
      "context_window": 204800,
      "free": false
    },
    {
      "name": "zai-glm-5.2",
      "display_name": "Z.AI GLM-5.2 (Coding Plan, API Key Required)",
      "api_type": "zai",
      "endpoint": "https://api.z.ai/api/coding/paas/v4",
      "model": "glm-5.2",
      "api_key": "",
      "temperature": 0.7,
      "max_tokens": 131072,
      "context_window": 1000000,
      "reasoning_effort": "high",
      "effort_options": ["high", "max"],
      "free": false
    },
    {
      "name": "claude-vertex",
      "display_name": "Claude on Vertex AI (GCP ADC; no API key)",
      "api_type": "vertex-anthropic",
      "endpoint": "",
      "project": "your-gcp-project",
      "location": "global",
      "model": "claude-opus-4-8",
      "max_tokens": 8192,
      "context_window": 1000000,
      "thinking": true,
      "free": false
    }
  ],
  "fast_model": "",
  "model_roles": {},
  "sub_agents": {
    "execution_model": "both",
    "allow_recursive": false,
    "max_subagents": 4,
    "max_depth": 3,
    "max_concurrent": 8,
    "token_budget": 0
  },
  "timeouts": {
    "model_seconds": 300,
    "tool_seconds": 300,
    "subagent_seconds": 300
  },
  "max_steps": 25,
  "window": {
    "resizable": true,
    "minimizable": true,
    "maximizable": true,
    "min_width": 50,
    "min_height": 12
  },
  "budget": {
    "token_budget": 0,
    "warn_fraction": 0.8
  },
  "rate_limit": {
    "requests_per_minute": 0,
    "burst": 0
  },
  "review_edits": false,
  "notify": {
    "enabled": true,
    "bell": true,
    "desktop": true,
    "native": false,
    "on_complete": true,
    "on_error": true,
    "on_approval": true,
    "on_clarify": true,
    "on_watcher": true,
    "suppress_when_focused": false
  },
  "mcp_servers": [],
  "diagnostics": {
    "command": ["go", "vet", "./..."],
    "warning_pattern": ""
  },
  "verify": {
    "command": ["go", "test", "./..."]
  },
  "theme": {
    "name": "default",
    "no_color": false,
    "no_shadow": false,
    "overrides": {}
  },
  "experimental": {
    "supervisor": false,
    "stream_thinking": false,
    "watchers": false
  },
  "supervisor": {
    "max_nudges": 3
  },
  "watchers": {
    "max_concurrent": 4,
    "default_skip_if_running": true
  }
}
