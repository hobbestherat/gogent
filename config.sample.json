      "model": "default",
      "temperature": 0.7,
      "max_tokens": 262144,
      "context_window": 262144,
      "free": true
    },
    {
      "name": "localhost",
      "display_name": "Localhost (127.0.0.1)",
      "api_type": "openai",
      "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
      "model": "default",
      "temperature": 0.7,
      "max_tokens": 262144,
      "context_window": 262144,
      "free": true
    },
    {
      "name": "groq",
      "display_name": "Groq (API Key Required)",
